{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drift",
  "version": "0.6.1",
  "identifier": "com.tglabs.drift",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Drift",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#F5F1E8",
        "visible": true
      },
      {
        "label": "magnet-toast",
        "url": "toast.html",
        "width": 360,
        "height": 120,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "backgroundColor": "#F5F1E8"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "createUpdaterArtifacts": true,
    "licenseFile": "../LICENSE",
    "fileAssociations": [
      {
        "ext": ["torrent"],
        "name": "BitTorrent file",
        "description": "BitTorrent metadata file",
        "mimeType": "application/x-bittorrent",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh",
        "minimumWebview2Version": "110.0.1531.0"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["magnet"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3OThCMTEzOTM0OTVFQgpSV1RybFRRNUVZdDVDN0djTGVSZldzTndCMTV5YUw1Y2ppZVd3dVNsR3hiL0RJRmFwamwwK054dQo=",
      "endpoints": [
        "https://github.com/tektungg/Drift/releases/latest/download/latest.json"
      ]
    }
  }
}
